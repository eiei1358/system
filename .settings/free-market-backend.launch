<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.springframework.boot.launch">
	<booleanAttribute key="org.springframework.boot.launch.ATTACH_ON_FAILURE" value="false"/>
	<stringAttribute key="org.eclipse.debug.core.ATTR_REFRESH_SCOPE" value="${project}"/>
	<booleanAttribute key="org.eclipse.debug.core.ATTR_REFRESH_RECURSIVE" value="true"/>
	<mapAttribute key="org.eclipse.debug.core.environmentVariables">
		<mapEntry key="spring.profiles.active" value="dev"/>
	</mapAttribute>
	<stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="com.example.furima.FreeMarketBackendApplication"/>
	<stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="free-market-backend"/>
	<stringAttribute key="org.eclipse.jdt.launching.VM_ARGUMENTS" value=""/>
</launchConfiguration>
